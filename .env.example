# Copia este archivo a .env y rellena los valores para desarrollo local.

DATABASE_URL="postgresql://skullystore:skullystore@localhost:5433/skullystore?schema=public"

# Genera uno con: openssl rand -base64 32
AUTH_SECRET=""

# Credenciales de tu app sandbox en https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_API_BASE="https://api-m.sandbox.paypal.com"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""

# Webhook ID de la app de PayPal (App → Add Webhook, apuntando a
# <tu-dominio>/api/paypal/webhook, evento "Payment capture completed").
# Sin esto, /api/paypal/webhook responde 503 -- es una red de seguridad por
# si la captura síncrona del pago nunca llega al servidor, no imprescindible
# para que el checkout normal funcione.
PAYPAL_WEBHOOK_ID=""

# SMTP para el email de recuperar contraseña -- sin SMTP_HOST/USER/PASSWORD,
# el enlace solo se imprime por consola (útil para desarrollo).
SMTP_HOST="smtp.buzondecorreo.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="SkullyStore <notificaciones@bskully.es>"

# Dirección donde llegan los avisos al admin (pedido nuevo, petición de aviso
# de stock). Opcional -- sin definir, se usa el email de contacto de
# src/lib/site-config.ts por defecto.
ADMIN_NOTIFICATION_EMAIL=""

# OAuth 2.0 Client ID de Google Cloud Console (APIs & Services > Credentials).
# Redirect URI en dev: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# La subida de imágenes de producto ("Subir imagen" en el admin) guarda los
# archivos en uploads/ -- no necesita configuración.

# API key de Google Maps Platform (Places API) para autocompletar la
# dirección al añadir una dirección de envío. Restringida por HTTP referrer
# a tu dominio -- es pública a propósito (se usa en el navegador), no un
# secreto. Sin ella, el formulario de dirección funciona igual pero sin el
# buscador de autocompletado.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# ID de medición de Google Analytics 4 (formato G-XXXXXXX), desde el panel
# de administración de GA4. Es pública a propósito (se usa en el navegador).
# Solo se carga si el visitante acepta el aviso de cookies -- sin esta
# variable, no se muestra ni el aviso ni se carga Analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Opcional: crea un usuario ADMIN al ejecutar `npx prisma db seed`.
# Sin estas dos variables, el seed no crea ningún admin.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

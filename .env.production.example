# En la VPS: copiar a `.env` (junto a docker-compose.prod.yml) y rellenar.
# docker compose lee este .env automáticamente para sustituir ${VARS} en
# docker-compose.prod.yml -- no confundir con el .env de desarrollo local.

# Contraseña del Postgres propio del store (contenedor "db" de docker-compose.prod.yml)
DB_PASSWORD=""

# Genera uno con: openssl rand -base64 32 (debe ser distinto al de desarrollo)
AUTH_SECRET=""

# URL pública real -- sin esto, Auth.js construye las redirecciones con la
# dirección interna del contenedor (0.0.0.0:3000) en vez del dominio real.
AUTH_URL="https://store.bskully.es"

# App "Live" de https://developer.paypal.com/dashboard/applications (no la sandbox)
PAYPAL_API_BASE="https://api-m.paypal.com"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""

# Webhook ID de la misma app Live (App → Add Webhook, apuntando a
# https://store.bskully.es/api/paypal/webhook, evento "Payment capture
# completed"). Red de seguridad por si la captura síncrona del pago nunca
# llega al servidor -- sin esto, /api/paypal/webhook responde 503 pero el
# checkout normal sigue funcionando igual.
PAYPAL_WEBHOOK_ID=""

# SMTP del buzón de bskully.es (buzondecorreo.com) para el email de
# recuperar contraseña.
SMTP_HOST="smtp.buzondecorreo.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="SkullyStore <notificaciones@bskully.es>"

# Dirección donde llegan los avisos al admin (pedido nuevo, petición de aviso
# de stock). Opcional -- sin definir, se usa el email de contacto de
# src/lib/site-config.ts por defecto.
ADMIN_NOTIFICATION_EMAIL=""

# OAuth 2.0 Client ID de Google Cloud Console. Redirect URI a autorizar:
# https://store.bskully.es/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# La subida de imágenes de producto ("Subir imagen" en el admin) guarda los
# archivos en un volumen Docker (uploads/) -- no necesita configuración ni
# credenciales.

# API key de Google Maps Platform (Places API), restringida por HTTP
# referrer a https://store.bskully.es/*. Es pública a propósito (se usa en
# el navegador). Sin ella, el formulario de dirección funciona igual pero
# sin el buscador de autocompletado. Debe llegar como build arg además de
# variable de entorno -- ver ARG/ENV en el Dockerfile.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# ID de medición de Google Analytics 4 (G-XXXXXXX). Igual que la de Google
# Maps, es pública a propósito y debe llegar como build arg (ver ARG/ENV en
# el Dockerfile). Solo se carga si el visitante acepta el aviso de cookies;
# sin esta variable, ni el aviso ni Analytics aparecen.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
